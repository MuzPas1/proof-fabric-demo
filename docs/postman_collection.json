{
  "info": {
    "_postman_id": "pfp-collection-v1",
    "name": "Proof Fabric Protocol (PFP) — API",
    "description": "Production-grade Financial Evidence Artifact (FEA) API + public verification + key registry. Built for cryptographically verifiable transactions. See /docs/DEVELOPER_GUIDE.md for the full integration story.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://demo.pfprotocol.com",
      "type": "string",
      "description": "Production base URL. Override with staging: https://pfp-evidence.preview.emergentagent.com"
    },
    {
      "key": "api_key",
      "value": "pfp_test_REPLACE_ME",
      "type": "string",
      "description": "X-API-Key. In sandbox: GET /api/config returns one. In prod: contact support@pfprotocol.com."
    },
    {
      "key": "fea_id",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the Generate FEA test script."
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "00 — Sandbox bootstrap",
      "item": [
        {
          "name": "GET /api/config (fetch sandbox key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.test_api_key) {",
                  "  pm.collectionVariables.set('api_key', data.test_api_key);",
                  "  console.log('Sandbox key stored in {{api_key}}:', data.test_api_key);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/api/config"
          }
        },
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/api/health"
          }
        }
      ]
    },
    {
      "name": "01 — FEA (authenticated)",
      "item": [
        {
          "name": "POST /api/fea/generate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Has fea_id', () => pm.expect(data.fea_id).to.be.a('string'));",
                  "pm.test('Has signature', () => pm.expect(data.signature).to.be.a('string'));",
                  "pm.collectionVariables.set('fea_id', data.fea_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/fea/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"idem-{{$timestamp}}-{{$randomUUID}}\",\n  \"transaction_id\": \"TXN-{{$randomUUID}}\",\n  \"timestamp\": \"2026-02-10T14:23:00Z\",\n  \"amount\": 245000,\n  \"currency\": \"INR\",\n  \"payer_id\": \"sha256:7b9cabd2b7a1e9c1f4a0d3b8e2f5a1c0\",\n  \"payee_id\": \"sha256:a14d8c2f9b4e5d6a1c8f2e3b9d0a5f7c\",\n  \"metadata\": { \"channel\": \"upi\", \"rail\": \"NPCI\" }\n}"
            }
          }
        },
        {
          "name": "POST /api/fea/generate — idempotent replay (200, same FEA)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/fea/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"idem-fixed-001\",\n  \"transaction_id\": \"TXN-IDEM-001\",\n  \"timestamp\": \"2026-02-10T14:23:00Z\",\n  \"amount\": 100000,\n  \"currency\": \"INR\",\n  \"payer_id\": \"sha256:aaa\",\n  \"payee_id\": \"sha256:bbb\"\n}"
            },
            "description": "Send twice — second call returns the SAME fea_id."
          }
        },
        {
          "name": "POST /api/fea/generate — replay attack (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/fea/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"idem-fixed-002\",\n  \"transaction_id\": \"TXN-IDEM-001\",\n  \"timestamp\": \"2026-02-10T14:23:00Z\",\n  \"amount\": 999999,\n  \"currency\": \"INR\",\n  \"payer_id\": \"sha256:aaa\",\n  \"payee_id\": \"sha256:bbb\"\n}"
            },
            "description": "Same (transaction_id, timestamp) with DIFFERENT amount → expect 409 Conflict."
          }
        },
        {
          "name": "POST /api/fea/verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/fea/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fea_payload\": { \"fea_version\": \"1.0\", \"issuer_id\": \"pfp-issuer-001\", \"public_key_id\": \"key_xxx\", \"transaction_summary\": { \"transaction_id\": \"TXN-001\", \"timestamp\": \"2026-02-10T14:23:00Z\", \"amount\": 245000, \"currency\": \"INR\" }, \"parties\": { \"payer_hash\": \"sha256:aaa\", \"payee_hash\": \"sha256:bbb\" }, \"fea_hash\": \"…\" },\n  \"signature\": \"PASTE_BASE64_SIGNATURE\",\n  \"signature_version\": \"v2\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "02 — Public verification (no auth)",
      "item": [
        {
          "name": "GET /api/public/verify/{fea_id}",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/api/public/verify/{{fea_id}}",
            "description": "Verify by ID using only the public registry. Independent of issuer auth."
          }
        },
        {
          "name": "GET /api/public/keys",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/api/public/keys"
          }
        }
      ]
    },
    {
      "name": "03 — Demo flow (powers demo.pfprotocol.com)",
      "item": [
        {
          "name": "POST /api/demo/issue",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/demo/issue",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"TXN-DEMO-001\",\n  \"user_id\": \"user_demo\",\n  \"amount\": \"2450.00\",\n  \"created_at\": \"2026-02-10T14:23:00Z\",\n  \"compliance\": { \"kyc\": \"Pass\", \"aml\": \"Pass\", \"limits\": \"Within allowed range\", \"status\": \"COMPLIANT\" }\n}"
            }
          }
        },
        {
          "name": "GET /api/demo/verify/{proof_id}",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/api/demo/verify/REPLACE_WITH_PROOF_ID"
          }
        },
        {
          "name": "POST /api/demo/artifact (downloadable)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/demo/artifact",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"TXN-DEMO-001\",\n  \"user_id\": \"user_demo\",\n  \"amount\": \"2450.00\",\n  \"compliance\": { \"kyc\": \"Pass\", \"aml\": \"Pass\", \"limits\": \"Within allowed range\", \"status\": \"COMPLIANT\" }\n}"
            }
          }
        },
        {
          "name": "POST /api/demo/artifact/verify",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/demo/artifact/verify",
            "body": {
              "mode": "raw",
              "raw": "{ /* paste the JSON returned by /api/demo/artifact */ }"
            }
          }
        }
      ]
    }
  ]
}
